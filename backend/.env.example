PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/impact_gift

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Outbound email (SMTP) — same pattern as KutirGRS backend/app/mail.py
# If SMTP_HOST is empty, emails are not sent; full message is printed to the API server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Impact Gift <noreply@example.com>

# Deprecated (Resend API removed — use SMTP_* above)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Optional: public URL for uploaded images (defaults to http://localhost:PORT)
# BACKEND_PUBLIC_URL=http://localhost:5001